{
  "name": "@multi-agent-ops/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include \"../shared/dist/**/*.js\" src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "model:verify": "tsx src/verify-model.ts",
    "search:verify": "node --use-env-proxy --import tsx src/verify-search.ts",
    "memory:verify": "tsx src/verify-memory.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311",
    "@multi-agent-ops/shared": "0.1.0",
    "better-sqlite3": "12.10.0",
    "mem0ai": "3.3.1",
    "ollama": "0.5.14",
    "pg": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "tsx": "4.23.15"
  }
}
