{
  "name": "multi-agent-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @multi-agent-ops/shared build && pnpm -r --parallel dev",
    "db:up": "node scripts/database.mjs up",
    "db:down": "node scripts/database.mjs down",
    "db:check": "node scripts/check-database.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @multi-agent-ops/shared build && pnpm -r typecheck && tsc -p tests/e2e/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @multi-agent-ops/shared build && pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "env:setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "pg": "^8.16.0"
  }
}
