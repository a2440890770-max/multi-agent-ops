{
  "name": "@multi-agent-ops/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../shared/dist/**/*.js src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@multi-agent-ops/shared": "0.1.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
