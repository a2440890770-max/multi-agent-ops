# 此文件只描述变量，不包含可用密钥。npm run env:setup 会生成本地 .env。
# PostgreSQL 开发库名、用户名、随机密码；仅供本地 Compose 使用。
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# 本机数据库端口，默认 5432。
POSTGRES_PORT=
# 后端数据库连接字符串；由 setup 生成。不要向前端暴露。
DATABASE_URL=
# 本机服务端口：前端默认 5173，后端 3001，Agent 空壳 3002。
FRONTEND_PORT=
BACKEND_PORT=
AGENT_PORT=
# 后端探测 Agent 的地址；本地默认 http://127.0.0.1:3002。
AGENT_BASE_URL=
# D2 模型验证：仅使用 DeepSeek 官方 API。只在本地填写官方 Key，不使用中转站 Key。
# SDK 的 Anthropic 兼容地址固定为 https://api.deepseek.com/anthropic。
# 普通服务启动不调用模型；npm run model:verify 会真实调用并产生费用。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REVIEW_MODEL=deepseek-flash
# D2 Mem0 OSS 内嵌模式：npm run memory:setup 单独生成 .env.memory。
# 下列变量仅供记忆组件使用，不回退使用业务 DATABASE_URL。
MEM0_DATABASE_URL=
MEM0_POSTGRES_DB=
MEM0_POSTGRES_USER=
MEM0_POSTGRES_PASSWORD=
MEM0_POSTGRES_PORT=55432
MEM0_OLLAMA_URL=http://127.0.0.1:11434
MEM0_EMBEDDING_MODEL=nomic-embed-text
MEM0_EMBEDDING_DIMENSION=768
MEM0_COLLECTION=mem0_ops_nomic_v1
# SDK 变更历史文件，相对路径以仓库根目录为基准；需与 PostgreSQL 数据一起备份。
MEM0_HISTORY_PATH=artifacts/memory/history.sqlite
# 后续 Cloud 接入使用，当前不会自动上传 Trace。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
