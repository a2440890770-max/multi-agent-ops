# 此文件只描述变量，不包含可用密钥。npm run env:setup 会生成本地 .env。
# PostgreSQL 开发库名、用户名、随机密码；仅供本地 Compose 使用。
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# 本机数据库端口，默认 5432。
POSTGRES_PORT=
# 后端数据库连接字符串；由 setup 生成。不要向前端暴露。
DATABASE_URL=
# 本机服务端口：前端默认 5173，后端 3001，Agent 空壳 3002。
FRONTEND_PORT=
BACKEND_PORT=
AGENT_PORT=
# 后端探测 Agent 的地址；本地默认 http://127.0.0.1:3002。
AGENT_BASE_URL=
# 后续阶段使用，D1 不需要填写，不会自动接入真实模型或 Cloud。
ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
