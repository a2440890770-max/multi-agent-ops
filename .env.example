# 此文件只描述变量，不包含可用密钥。npm run env:setup 会生成本地 .env。
# PostgreSQL 管理身份；仅供本地 Compose 和显式初始化使用，禁止用于业务运行。
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# 本机数据库端口，默认 5432。
POSTGRES_PORT=
# 后端独立非超级用户连接；由 setup 生成，与管理员、Mem0 角色分离。
DATABASE_URL=
# 本机独立服务端口：前端默认 5173，后端 3001，Agent 3002。
FRONTEND_PORT=
BACKEND_PORT=
AGENT_PORT=
# 后端探测 Agent 的地址；本地默认 http://127.0.0.1:3002。
AGENT_BASE_URL=
# 后端与独立 Agent 共用的 32 字节随机密钥，编码为 64 位十六进制；留空时执行入口不可用。
AGENT_SERVICE_TOKEN=
# Agent 回查执行权的固定后端 origin；默认按 BACKEND_PORT 使用本机后端，非本机必须 HTTPS。
BACKEND_INTERNAL_BASE_URL=
# Session 认证：32 字节随机密钥的 64 位十六进制编码，仅填入本地 .env 或部署秘密配置。
AUTH_SECRET=
# 精确 Origin，逗号分隔；生产必须使用同源 HTTPS 并设置 NODE_ENV=production。
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001,http://localhost:3001
# D4 执行器：本地默认 mock，模拟进度写入业务库，不调用真实模型或发布。
# agent 启用独立 Agent 服务链路；disabled 禁止启动/重试；生产默认 disabled，禁止 mock。
TASK_EXECUTOR_MODE=mock
# 真实模式需要下方版本化人民币计价，同时显式提供 SDK 的美元估算预算；两种口径独立，不隐式换算。
AGENT_SESSION_MAX_BUDGET_USD=0.10
AGENT_MAX_TURNS=32
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_SESSION_MAX_TOKENS=100000
# agent 固定调用/步骤 15 分钟、attempt 活动累计 20 分钟，不自动技术重试；初次输出后最多纠正两次。
# TASK_CALL_TIMEOUT_MS / TASK_STEP_TIMEOUT_MS / TASK_TECHNICAL_MAX_RETRIES 保留供 mock 使用。
# 执行器随后端启动；并发是每个执行器的上限。
TASK_EXECUTOR_CONCURRENCY=1
TASK_EXECUTOR_POLL_MS=500
TASK_EXECUTOR_HEARTBEAT_MS=5000
# 租约必须至少为心跳及轮询间隔的三倍；失效尝试不会自动重跑。
TASK_EXECUTOR_LEASE_MS=30000
# D2 模型验证：仅使用 DeepSeek 官方 API。只在本地填写官方 Key，不使用中转站 Key。
# SDK 的 Anthropic 兼容地址固定为 https://api.deepseek.com/anthropic。
# 普通服务启动不调用模型；npm run model:verify 会真实调用并产生费用。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REVIEW_MODEL=deepseek-flash
# Research 只读 GitHub 热榜适配器：只在本地 .env 或服务端环境中填写，不使用 VITE_*。
# 普通服务启动和自动测试不会调用；显式 fetchGithubHot() 使用此密钥。
XXAPI_ACCESS_KEY=
# Research 网页：仅在显式配置 webTools 后生效；原生工具内部网络重试不可据此推定。
# 工具不主动重试，Research 的再次调用计入同一轮额度，并获得新的单次时限。
RESEARCH_WEB_ROOT=artifacts/research
RESEARCH_WEB_MAX_SEARCH_CALLS=12
RESEARCH_WEB_MAX_FETCH_CALLS=10
RESEARCH_WEB_MAX_SEARCH_RESULTS=10
RESEARCH_WEB_TIMEOUT_MS=60000
# 独立原文读取的解压响应上限；超限失败，不保留半截响应作证据。
RESEARCH_WEB_MAX_RESPONSE_BYTES=10485760
RESEARCH_WEB_MAX_TEXT_CHARACTERS=50000
RESEARCH_WEB_MAX_REDIRECTS=5
# fetch_video：仅显式调用时读取 Chrome；模型不能选择浏览器、目录或命令参数。
# 本机 yt-dlp 已安装在 /Users/liutingfei/.local/bin/yt-dlp；也可使用 PATH 中的命令名。
FETCH_VIDEO_YTDLP_PATH=yt-dlp
FETCH_VIDEO_FFMPEG_PATH=ffmpeg
FETCH_VIDEO_FFPROBE_PATH=ffprobe
FETCH_VIDEO_ROOT=artifacts/media
FETCH_VIDEO_CHROME_PROFILE=Default
# 包含 Cookie 读取、解析、下载与媒体校验；无视频时长和文件大小上限。
FETCH_VIDEO_TIMEOUT_MS=600000
# 以短边计，兼容横屏 1280x720 与竖屏 720x1280。
FETCH_VIDEO_MAX_RESOLUTION=720

# extract_audio：只处理已登记的视频；目录共用 FETCH_VIDEO_ROOT，不联网或转写。
# 留空时复用 FETCH_VIDEO_FFMPEG_PATH / FETCH_VIDEO_FFPROBE_PATH。
EXTRACT_AUDIO_FFMPEG_PATH=
EXTRACT_AUDIO_FFPROBE_PATH=
# 总时限包含资源校验、并发等待、逐帧检查、提取与结果校验；不限制音频大小/时长。
EXTRACT_AUDIO_TIMEOUT_MS=600000

# transcribe_audio：本机命令调用，不需要 HTTP 接口或 API Key；不会自动下载模型。
TRANSCRIBE_AUDIO_WHISPER_PATH=whisper-cli
# 留空时使用当前用户 ~/.local/share/whisper.cpp/models/ggml-small.bin；可配置绝对路径。
TRANSCRIBE_AUDIO_MODEL_PATH=
TRANSCRIBE_AUDIO_TIMEOUT_MS=600000
TRANSCRIBE_AUDIO_THREADS=4

# extract_frames：受控抽帧，不调用视觉模型或 OCR；目录共用 FETCH_VIDEO_ROOT。
EXTRACT_FRAMES_FFMPEG_PATH=
EXTRACT_FRAMES_FFPROBE_PATH=
EXTRACT_FRAMES_TIMEOUT_MS=600000
EXTRACT_FRAMES_DEFAULT_COUNT=12
EXTRACT_FRAMES_MAX_FRAMES=30
# PNG 长边上限，不能超过首版约定的 1920；保持比例且不放大。
EXTRACT_FRAMES_MAX_LONG_EDGE=1920
# D2 Mem0 OSS 内嵌模式：npm run memory:setup 单独生成 .env.memory。
# 同一 PostgreSQL 实例、独立数据库和运行角色；不回退使用业务 DATABASE_URL。
# OPENAI_API_KEY 仅用于官方嵌入接口，嵌入调用产生费用。
MEM0_DATABASE_URL=
MEM0_POSTGRES_DB=
MEM0_POSTGRES_USER=
MEM0_POSTGRES_PASSWORD=
OPENAI_API_KEY=
MEM0_EMBEDDING_MODEL=text-embedding-3-small
MEM0_EMBEDDING_DIMENSION=1536
MEM0_COLLECTION=mem0_ops_openai_small_v1
# SDK 变更历史文件，相对路径以仓库根目录为基准；需与 PostgreSQL 数据一起备份。
MEM0_HISTORY_PATH=artifacts/memory/history.sqlite
# 后续 Cloud 接入使用，当前不会自动上传 Trace。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# D9 第二批：排队/澄清等待不计入执行总时长；技术重试等待计入。
TASK_CALL_TIMEOUT_MS=120000
TASK_STEP_TIMEOUT_MS=300000
TASK_ATTEMPT_TIMEOUT_MS=1200000
TASK_TECHNICAL_MAX_RETRIES=2
TASK_TECHNICAL_RETRY_BASE_MS=2000
# 任务级累计预算跨人工重试保留；费用单位为百万分之一人民币元，1000000 = 1 元。
TASK_BUDGET_MAX_CALLS=50
TASK_BUDGET_MAX_TOKENS=100000
TASK_BUDGET_MAX_COST_MICROS_CNY=1000000
# 真实模型接入前，三项计价配置必须同时提供；不内置实时单价或汇率。
# 单价单位：每百万 Token 的人民币百万分之一元；1 元/百万 Token 填 1000000。
# 2026-11-09 用户确认：Flash 保守高峰估算，不扣缓存折扣；不是供应商实际账单。
TASK_MODEL_PRICING_VERSION=deepseek-flash-20261109-peak-conservative-v1
TASK_MODEL_INPUT_MICROS_CNY_PER_MILLION=2000000
TASK_MODEL_OUTPUT_MICROS_CNY_PER_MILLION=8000000
# Research 仅在 agent 模式、迁移/能力齐备并显式开启时装配；模板默认关闭。
TASK_RESEARCH_ENABLED=false
# 每个已准入网页调用预占 0.005 元；失败/未知消耗保守计入，不假装供应商零收费。
TASK_WEB_REQUEST_MICROS_CNY=5000
# 可选：仅供显式 agent-execution:test 指向本机测试管理连接；验证创建、清理独立临时库和受限角色。
# 不指向业务数据库，不提交含凭据的实际连接值。
AGENT_TEST_ADMIN_URL=
